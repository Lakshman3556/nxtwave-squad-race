# NxtWave Squad Race Environment Configuration
# Copy this to .env.local for local testing and set these in Vercel project settings

# Admin dashboard security key (protects /admin route)
ADMIN_KEY=nxtwave_growth_2027

# Optional: Supabase Postgres Integration (if deploying to cloud Supabase)
# If omitted or offline, the app seamlessly runs on the built-in resilient local relational store
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: LLM API key for AI Project Idea generator (Gemini or OpenAI)
# If omitted, the app uses deterministic branch-specific templates with 100% reliability
GEMINI_API_KEY=
OPENAI_API_KEY=

# Base URL for referral link generation (defaults to current host in browser)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
